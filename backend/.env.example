APP_NAME="WeeGrow"
SESSION_COOKIE=toddler-daily-session
CACHE_PREFIX=toddler-daily-cache-
REDIS_PREFIX=toddler-daily-database-
# Optional guest access in this application database; ordinary family authorization still applies.
DEMO_MODE=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4300
FRONTEND_URL=http://localhost:4300
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=toddler_daily
DB_USERNAME=sail
DB_PASSWORD=local-development-only
DB_SCHEMA=app
DB_SSLMODE=disable
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:4300,localhost:8000,127.0.0.1:4300,127.0.0.1:8000
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@toddler-daily.test
MAIL_FROM_NAME="WeeGrow"
REMINDER_EMAIL_ENABLED=false
MAINTENANCE_SECRET=
PRIVACY_NOTICE_VERSION=2026-11-01
LOG_CHANNEL=stderr
LOG_LEVEL=warning
